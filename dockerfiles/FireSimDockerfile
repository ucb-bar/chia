# FireSim manager for one local F2 FPGA; the driver comes prebuilt, so no chipyard.
ARG BASE_IMAGE=ghcr.io/ucb-bar/chia:latest
FROM ${BASE_IMAGE}

USER root

# curl: the manager's EC2 check. graphviz: the topology diagram it draws.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    rsync \
    ca-certificates \
    curl \
    graphviz \
    && rm -rf /var/lib/apt/lists/*

# fab-classic on paramiko, as FireSim's build-setup installs it; cryptography and
# pyOpenSSL pinned as the matching pair from chipyard's lock file.
RUN PARAMIKO_REPLACE=1 pip install --no-cache-dir --no-binary fab-classic \
    'fab-classic>=1.19.2' \
    'fsspec' \
    's3fs' \
    'boto3' \
    'mypy-boto3-ec2' \
    'mypy-boto3-s3' \
    'pylddwrap' \
    'pyyaml' \
    'argcomplete' \
    'colorama' \
    'cryptography==40.0.2' \
    'pyOpenSSL==23.2.0'

USER ray
ENV HOME=/home/ray
WORKDIR /home/ray

# The FireSim of chipyard's chia_artifact branch, which builds the bitstreams and
# drivers this image runs. The manager checks out its aws-fpga commit on the run host.
ARG FIRESIM_REPO=https://github.com/firesim/firesim.git
ARG FIRESIM_REF=chia_artifact

RUN git clone --depth 1 -b ${FIRESIM_REF} ${FIRESIM_REPO} /home/ray/firesim \
    && git -C /home/ray/firesim submodule update --init --depth 1 platforms/f2/aws-fpga-firesim-f2 \
    && git -C /home/ray/firesim rev-parse HEAD

# sourceme-manager.sh sources env.sh, which build-setup.sh would generate.
RUN printf 'export FIRESIM_ENV_SOURCED=1\nexport FS_DIR=/home/ray/firesim\n' \
      > /home/ray/firesim/env.sh

# The sample configs, as managerinit would copy them, but no build recipes: FireSim
# reads them on every run, and they name chipyard paths this image lacks.
RUN cd /home/ray/firesim/deploy \
    && for f in build hwdb runtime; do \
         cp sample-backup-configs/sample_config_$f.yaml config_$f.yaml; \
       done \
    && echo "{}" > config_build_recipes.yaml \
    && mkdir -p logs results-build results-workload

ENV FIRESIM_DIR=/home/ray/firesim
WORKDIR /home/ray
